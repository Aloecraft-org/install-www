{
    "name": "install-www",
    "compatibility_date": "2026-11-01",
    // Static site only: no Worker script, everything in www/ is served as-is.
    "assets": {
        "directory": "./www"
    },
    // aloecraft.org must be a zone in the account you deploy to; zone_name is
    // spelled out because a narrowly scoped API token cannot look it up. Wrangler
    // creates the DNS record and certificate for the hostname on deploy.
    "routes": [
        { "pattern": "install.aloecraft.org", "custom_domain": true, "zone_name": "aloecraft.org" }
    ]
}
